# Google Cloud OAuth 2.0 credentials for the Google Health API.
# Create them at https://console.cloud.google.com (see README).
# Copy this file to ".env" and fill in your values.

GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Redirect URI registered in your Google Cloud OAuth client (must match exactly).
# Add this exact value under "Authorized redirect URIs":
GOOGLE_REDIRECT_URI=http://localhost:8080/callback

# Where OAuth tokens get stored after you run authorize.py
FITBIT_TOKEN_FILE=.fitbit_tokens.json

# --- Hosting only (set as platform secrets, NOT in a committed .env) ---
# Required for any public deployment — enables the login gate (health data!).
# SIGNALS_PASSWORD=choose-a-strong-password
# SIGNALS_USER=signals
# Persistent volume paths (Fly defaults shown; set via fly.toml/env):
# SIGNALS_DATA_DIR=/data
# FITBIT_TOKEN_FILE=/data/.fitbit_tokens.json
# Seed the OAuth token onto a fresh volume (contents of your local
# .fitbit_tokens.json). Refreshes are then written back to the volume:
# FITBIT_TOKENS_JSON={"access_token":...}
